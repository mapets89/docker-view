FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS backend
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/dockerview-gateway ./cmd/gateway

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
    && addgroup -S -g 10002 gateway && adduser -S -D -H -u 10002 -G gateway gateway
COPY --from=backend /out/dockerview-gateway /usr/local/bin/dockerview-gateway
USER 10002:10002
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/dockerview-gateway"]
