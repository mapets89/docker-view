FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache libcrypto3 libssl3 \
    && addgroup -S -g 10003 secret-init && adduser -S -D -H -u 10003 -G secret-init secret-init \
    && mkdir -p /secrets && chown secret-init:secret-init /secrets
USER 10003:10003
