{
  "name": "dockerview-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "check": "astro check && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.native.json",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.3.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0"
  }
}
