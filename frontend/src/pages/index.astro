---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="theme-color" content="#090d12" /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    /><title>DockerView · Sign in</title></head
  >
  <body data-page="auth" class="auth-page"
    ><main class="auth-shell">
      <section class="auth-intro">
        <a class="brand"
          ><span class="brand-mark"><i></i><i></i><i></i></span><span
            >Docker<span>View</span></span
          ></a
        ><div>
          <p class="kicker">Controlled troubleshooting</p><h1>
            See the system.<br /><em>Touch only what’s allowed.</em>
          </h1><p>
            One focused interface for container state, logs, configuration risk,
            and audited terminal access.
          </p>
        </div><div class="boundary">
          <span>Security boundary</span><b
            >Web/API → authenticated Gateway → Docker Engine</b
          >
        </div>
      </section><section class="auth-card">
        <div id="auth-loading">
          <span class="spinner"></span><p>Checking instance state…</p>
        </div><form id="login-form" hidden>
          <p class="kicker">Welcome back</p><h2>Sign in to DockerView</h2><label
            >Username<input
              name="username"
              autocomplete="username"
              required
              minlength="3"
              maxlength="64"
              autofocus
            /></label
          ><label
            >Password<input
              name="password"
              type="password"
              autocomplete="current-password"
              required
              maxlength="1024"
            /></label
          ><button class="primary" type="submit">Sign in <span>→</span></button
          ><p class="form-error" role="alert"></p><details
            class="recovery-help"
          >
            <summary>Forgot password?</summary><p>
              Ask another Administrator to reset it from Users. If this is the
              only Administrator, run this command on the Docker host:
            </p><code
              >docker compose exec dockerview dockerview-server reset-password
              --username USERNAME</code
            >
          </details>
        </form><div id="setup-help" class="recovery-help" hidden>
          <p class="kicker">First run</p><h2>Create the administrator</h2>
          <p>
            Run the appropriate command in a terminal on the host, replacing
            ADMIN with your username. You will be prompted for a password.
          </p>
          <p>Compose, from the project directory:</p>
          <code
            >docker compose exec dockerview dockerview-server bootstrap
            --username ADMIN</code
          >
          <p>Local development, from the project directory:</p>
          <code
            >cd backend &amp;&amp; DOCKERVIEW_DB_PATH=../.local/dockerview.db go
            run ./cmd/server bootstrap --username ADMIN</code
          >
          <p>After creating the account, refresh this page and sign in.</p>
        </div>
      </section>
    </main><script>
      import "../scripts/app.ts";
    </script></body
  >
</html>
