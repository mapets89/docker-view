---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Containers" page="containers"
  ><div class="toolbar">
    <label class="search"
      ><span>⌕</span><input
        id="container-search"
        placeholder="Search name or image"
      /></label
    ><select id="status-filter" aria-label="Filter by status"
      ><option value="">All states</option><option>running</option><option
        >exited</option
      ><option>paused</option></select
    ><div class="sort-control">
      <span>Sort by</span><div class="sort-field">
        <select id="container-sort"
          ><option value="name">Container</option><option value="status"
            >Status</option
          ><option value="resources">Resources</option><option value="risk"
            >Risk</option
          ></select
        ><button
          class="sort-direction"
          id="container-sort-direction"
          type="button"
          title="Ascending"
          aria-label="Sort ascending">↑</button>
      </div>
    </div><span class="count" id="container-count">— containers</span>
  </div><section class="panel flush containers-panel">
    <div class="table-wrap">
      <table class="containers-table">
        <colgroup>
          <col class="container-col" /><col class="status-col" /><col
            class="usage-col"
          /><col class="ports-col" /><col class="risk-col" /><col
            class="actions-col"
          />
        </colgroup>
        <thead
          ><tr
            ><th data-sort="name">Container</th><th>Status</th><th>Resources</th
            ><th>Published ports</th><th>Risk</th><th>Actions</th></tr
          ></thead
        ><tbody id="containers-table"
          ><tr class="empty-row"
            ><td colspan="6" class="empty">Loading inventory…</td></tr
          ></tbody
        >
      </table>
    </div>
  </section><dialog id="container-detail">
    <button class="dialog-close" aria-label="Close">×</button><div
      id="container-detail-content"
    >
    </div>
  </dialog></AppLayout
>
