DOCKERVIEW_INSTANCE_NAME=DockerView
DOCKERVIEW_ENVIRONMENT=DEV
DOCKERVIEW_PORT=8080
DOCKER_GID=0
DOCKERVIEW_SESSION_TTL=12h
DOCKERVIEW_TERMINAL_IDLE_TIMEOUT=15m
DOCKERVIEW_LOG_TAIL_DEFAULT=500
# Generate with: openssl rand -hex 32
# Compose generates this automatically. Standalone binaries may set:
# DOCKERVIEW_GATEWAY_SECRET=<at-least-32-random-characters>
# DOCKERVIEW_GATEWAY_SECRET_FILE=/run/secrets/dockerview-gateway
DOCKERVIEW_COOKIE_SECURE=false
DOCKERVIEW_SECRET_MASKING=true
DOCKERVIEW_ALLOWED_ORIGINS=http://localhost:8080
